# Environment Configuration
# Copy this file to .env and fill in your values
# For Railway deployment, set these as environment variables in the Railway dashboard

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=false

# Supabase Configuration (Required)
# Get these values from: https://supabase.com/dashboard → Your Project → Settings → API

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (safe to use in frontend and backend)
SUPABASE_KEY=your-anon-key-here

# Storage bucket name (deprecated - kept for future implementation)
SUPABASE_STORAGE_BUCKET=your-bucket-name

# Student account password salt
STUDENT_PASSWORD_SALT=iksan_student_pwd_

# LLM Configuration
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Max file size for uploads (in bytes)
MAX_FILE_SIZE=10485760

# CORS Configuration
# For production, replace with your frontend URL(s)
BACKEND_CORS_ORIGINS=["*"]

# Rate Limiting Configuration
# Set to false to disable rate limiting (not recommended for production)
RATE_LIMIT_ENABLED=true

# Default rate limit for most endpoints (format: "X/period" where period = second, minute, hour, day)
RATE_LIMIT_DEFAULT=60/minute

# Strict rate limit for authentication endpoints (login, register) - protects against brute force
RATE_LIMIT_AUTH=5/minute

# Rate limit for LLM-heavy endpoints (session initiate, submit) - protects against abuse
RATE_LIMIT_LLM=10/minute

# Relaxed rate limit for health check endpoints
RATE_LIMIT_HEALTH=120/minute

# Third-Party API Keys
# Replace with your actual API keys
DEEPGRAM_API_KEY=your-deepgram-api-key-here

GEMINI_API_KEY=your-gemini-api-key-here

DB_PASSWORD=your-database-password-here

REDIS_URL=your-redis-url-here

JOB_PROCESSING_INTERVAL_SECONDS=7
# Note: Do NOT commit the actual .env file to git!
# Copy this file to .env and fill in your actual values.

# JWT Configuration
JWT_SECRET_KEY=random_test_key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=iksan-ai-interview
JWT_AUDIENCE=iksan-ai-interview-api

# Database Configuration
# Example for PostgreSQL:
DATABASE_URL=postgresql://username:password@host:port/dbname?sslmode=require